# Copy to .env and edit. Launchers source .env when present (set -a), and train/_common/launch-rl.sh
# passes it to every Slurm node.

# Where datasets, runs, eval outputs and exported models are written (default: ./ibis_data).
IBIS_DATA=ibis_data

# Required on the paper's stack (cuBLAS 12.9 + PyTorch 2.10+): bf16 matmul crashes without it.
TORCH_BLAS_PREFER_CUBLASLT=1
# vLLM engine start-up for Qwen3-30B-A3B can exceed the default timeout on a cold compile cache.
VLLM_ENGINE_READY_TIMEOUT_S=1800

# Compile caches on node-local disk (shared filesystems cause stale-file-handle errors).
TRITON_CACHE_DIR=/tmp/${USER}/triton
TRITON_HOME=/tmp/${USER}/triton
VLLM_CACHE_ROOT=/tmp/${USER}/vllm
FLASHINFER_WORKSPACE_BASE=/tmp/${USER}/flashinfer

# prime-rl converts HF weights on first load and writes the result into the model snapshot,
# so the Hugging Face cache must be writable by the job.
HF_HUB_CACHE=${HOME}/.cache/huggingface/hub
HF_TOKEN=

# Weights & Biases (optional; set WANDB_MODE=offline to log locally).
WANDB_ENTITY=
WANDB_API_KEY=

# Frontier-model baselines only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
